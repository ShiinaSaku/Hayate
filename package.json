{
  "name": "hayate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "build:all": "bun build.ts --all",
    "build:deb": "bun build.ts --all --deb",
    "build:android": "bun build.ts --all --android",
    "build:everything": "bun build.ts --all --android --deb",
    "typecheck": "bun tsc --noEmit",
    "tegami": "bun scripts/tegami.mts",
    "npm:build": "cd npm/hayate && node ../../node_modules/.bin/tsdown",
    "npm:release": "bun scripts/npm-release.mts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.1",
    "tegami": "^1.2.5",
    "tsdown": "^0.22.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "tegami@1.2.5": "patches/tegami@1.2.5.patch"
  }
}
