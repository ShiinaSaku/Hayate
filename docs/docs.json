{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Hayate",
  "description": "Encrypted, compressed LAN file transfer. One binary, no cloud, no accounts, no SSH.",
  "colors": {
    "primary": "#171717",
    "light": "#fafafa",
    "dark": "#171717"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
        "href": "/quickstart"
      },
      {
        "label": "crates.io",
        "href": "https://crates.io/crates/hayate"
      },
      {
        "label": "docs.rs",
        "href": "https://docs.rs/hayate"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/ShiinaSaku/Hayate"
    }
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Guides",
        "icon": "book-open",
        "description": "Install, use and secure Hayate",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "installation",
              "quickstart"
            ]
          },
          {
            "group": "Using Hayate",
            "pages": [
              "guides/sending-and-receiving",
              "guides/discovery",
              "guides/dashboard",
              "guides/scripting",
              "guides/performance"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/how-it-works",
              "security/threat-model"
            ]
          },
          {
            "group": "More",
            "pages": [
              "comparison"
            ]
          }
        ]
      },
      {
        "dropdown": "CLI reference",
        "icon": "terminal",
        "description": "Every command, flag and exit code",
        "groups": [
          {
            "group": "Commands",
            "pages": [
              "cli/overview",
              "cli/send",
              "cli/receive",
              "cli/discover",
              "cli/web",
              "cli/peers-and-history",
              "cli/docs-and-completions"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "cli/exit-codes",
              "cli/json-events"
            ]
          }
        ]
      },
      {
        "dropdown": "Rust library",
        "icon": "box",
        "description": "Embed the transfer engine",
        "groups": [
          {
            "group": "Library",
            "pages": [
              "library/overview",
              "library/sending",
              "library/receiving",
              "library/errors"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ShiinaSaku/Hayate"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "fonts": {
    "family": "Geist"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  }
}
